{
  "rewrites": [
    {
      "source": "/api/dna/chart/:symbol",
      "destination": "/api/dna-chart?symbol=:symbol"
    },
    {
      "source": "/api/dna/report/:symbol",
      "destination": "/api/dna?action=report&symbol=:symbol"
    },
    {
      "source": "/api/dna/search",
      "destination": "/api/dna?action=search"
    },
    {
      "source": "/dna-mobile-story.html",
      "destination": "/dna-mobile-story.html"
    },
    {
      "source": "/dna",
      "destination": "/dna-mobile-story.html"
    },
    {
      "source": "/dna-story",
      "destination": "/dna-mobile-story.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
