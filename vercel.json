{
  "functions": {
    "api/*.ts": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/m/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    }
  ],
  "rewrites": [
    {
      "source": "/app/",
      "destination": "/app/index.html"
    },
    {
      "source": "/m",
      "destination": "/m/index.html"
    },
    {
      "source": "/m/:path*",
      "destination": "/m/index.html"
    },
    {
      "source": "/lab/api/:path*",
      "destination": "https://quantsync-api.duckdns.org:8443/lab/:path*"
    },
    {
      "source": "/lab",
      "destination": "/lab.html"
    },
    {
      "source": "/api/dna/chart/:symbol",
      "destination": "/api/dna-chart?symbol=:symbol"
    },
    {
      "source": "/api/terminal-data",
      "destination": "/api/terminal-data"
    },
    {
      "source": "/api/terminalData",
      "destination": "/api/terminalData"
    },
    {
      "source": "/api/terminalDataV3",
      "destination": "/api/terminalDataV3"
    },
    {
      "source": "/api/chart",
      "destination": "/api/chart"
    },
    {
      "source": "/api/intel",
      "destination": "/api/intel"
    },
    {
      "source": "/api/upcoming-stocks",
      "destination": "/api/upcoming-stocks"
    },
    {
      "source": "/api/feeds/:match*",
      "destination": "/api/feeds/:match*"
    },
    {
      "source": "/api/push-notification",
      "destination": "/api/push-notification"
    },
    {
      "source": "/api/:match*",
      "destination": "https://quantsync-api.duckdns.org:8443/api/:match*"
    },
    {
      "source": "/dna-v2",
      "destination": "/dna-v2.html"
    },
    {
      "source": "/dna-v2.html",
      "destination": "/dna-v2.html"
    },
    {
      "source": "/dna-mobile-story.html",
      "destination": "/dna-mobile-story.html"
    },
    {
      "source": "/dna",
      "destination": "/dna-mobile-story.html"
    },
    {
      "source": "/dna-story",
      "destination": "/dna-mobile-story.html"
    },
    {
      "source": "/screener",
      "destination": "/screener.html"
    },
    {
      "source": "/stock-detail",
      "destination": "/stock-detail.html"
    },
    {
      "source": "/stock/:symbol",
      "destination": "/stock-detail.html?symbol=:symbol"
    },
    {
      "source": "/chat",
      "destination": "/chat.html"
    },
    {
      "source": "/chat.html",
      "destination": "/chat.html"
    },
    {
      "source": "/bagalur",
      "destination": "/bagalur_community_3d.html"
    },
    {
      "source": "/bagalur_community_3d.html",
      "destination": "/bagalur_community_3d.html"
    },
    {
      "source": "/uploads/:match*",
      "destination": "https://quantsync-api.duckdns.org:8443/uploads/:match*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/app",
      "destination": "/app/",
      "permanent": false
    }
  ]
}
