{
  "rewrites": [
    {
      "source": "/api/dna/chart/:symbol",
      "destination": "/api/dna?action=chart&symbol=:symbol"
    },
    {
      "source": "/api/dna/report/:symbol",
      "destination": "/api/dna?action=report&symbol=:symbol"
    },
    {
      "source": "/api/dna/search",
      "destination": "/api/dna?action=search"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
