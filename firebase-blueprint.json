{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "createdAt": {
          "type": "number",
          "description": "Timestamp of creation"
        }
      },
      "required": ["email", "createdAt"]
    },
    "DeviceToken": {
      "title": "Device Token",
      "description": "FCM device token for push notifications",
      "type": "object",
      "properties": {
        "token": { "type": "string" },
        "userId": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["token", "userId"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "Stores user profiles."
    },
    "device_tokens/{tokenId}": {
      "schema": {
        "$ref": "#/entities/DeviceToken"
      },
      "description": "Stores FCM device tokens for push notifications."
    }
  }
}
